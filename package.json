{
  "name": "peario",
  "private": true,
  "description": "A chat based file sharing application between two peers.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "bun --filter @peario/client dev",
    "dev:server": "bun --filter @peario/server dev",
    "dev": "bun --filter '*' dev",
    "build": "bunx tsc --build && bun --filter @peario/client build && bun --filter @peario/server build",
    "type-check": "bunx tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run type-check && bun run lint && bun run format:check && bun run test",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test e2e/file-transfer.spec.ts e2e/transfer-controls.spec.ts",
    "test:e2e:large": "playwright test e2e/large-file-transfer.spec.ts",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test e2e/file-transfer.spec.ts --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "catalog": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@socket.io/bun-engine": "^0.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "oxc-transform-react": "^0.145.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-icons": "^5.7.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "tslog": "^4.10.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.4",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
